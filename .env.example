# Copy to .env.local for local development, and set the same values in the
# Vercel project settings for production. .env.local is gitignored — never
# commit real credentials.

# ---------------------------------------------------------------------------
# Neon Postgres — TWO connection strings, on purpose.
#
# DATABASE_URL          POOLED   (hostname contains "-pooler")  -> the app
# DATABASE_URL_UNPOOLED DIRECT   (no "-pooler")                 -> migrations
#
# The app uses Neon's HTTP driver, which is happiest against the pooled
# endpoint. Schema migrations need session-level features that a transaction
# pooler doesn't reliably provide, so drizzle-kit uses the direct one.
# Both are on the same database — same data either way.
#
# Neon console -> your project -> Connect. Toggle "Connection pooling" to get
# each form, and click "Show password" before copying.
# ---------------------------------------------------------------------------
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Shared secret the weekly backup cron must present (SPEC.md §2.1).
CRON_SECRET=""

# Where the weekly JSON backup lands. Safe to leave blank for now — the backup
# route no-ops with a warning rather than failing the deploy.
BACKUP_GITHUB_REPO=""    # e.g. "yourname/pickleplay-backups"
BACKUP_GITHUB_TOKEN=""   # fine-grained PAT, contents:write on that repo only
